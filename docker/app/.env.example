# Copy to .env (or run docker/app/setup_env.sh, which writes it for you). Read by compose.yaml.
HOST_UID=1000
HOST_GID=1000
# Group id that owns the serial nodes: stat -L -c %g /dev/serial/by-id/<board>-if00
SERIAL_GID=46
# Host ports (by-id paths survive renumbering; a re-plug still needs `up hw --force-recreate`).
RADAR_CLI=/dev/serial/by-id/usb-Texas_Instruments_XDS110_..._-if00
RADAR_DATA=/dev/serial/by-id/usb-Texas_Instruments_XDS110_..._-if03
# Paths inside the container (the shipped system JSONs name /dev/ttyACM0 and /dev/ttyACM1).
# RADAR_CLI_IN=/dev/ttyACM0
# RADAR_DATA_IN=/dev/ttyACM1
# GUI bind. A non-loopback address (LAN, tailnet) is unauthenticated: anyone who can reach it can start the radar.
GUI_HOST=127.0.0.1
GUI_PORT=8090
