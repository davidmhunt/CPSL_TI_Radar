{
 "env": {
  "RADAR_GUI_DRIVER": "tests/fakes/fake_driver.py",
  "FAKE_DRIVER_MODE": "stall",
  "FAKE_DRIVER_RATE": "10",
  "FAKE_DRIVER_PERIOD_MS": "100"
 },
 "user_cfgs": {
  "bench_1843_tlv.json": "{\"schema_version\": 2, \"board\": \"IWR1843\", \"firmware\": \"demo\", \"radar_cfg\": \"bench_1843_tlv.cfg\", \"cli\": {\"port\": \"@PORT@\"}, \"serial_stream\": {\"enabled\": true}}",
  "bench_1843_tlv.cfg": "% fake\n",
  "rig1843.cfg": "flushCfg\nsensorStart\n"
 },
 "scenarios": [
  {
   "name": "a_zero_frames",
   "tab": "run",
   "window": [
    1400,
    1000
   ],
   "actions": [
    {
     "set": "#rCfg",
     "value": "bench_1843_tlv"
    },
    {
     "click": "#rStart"
    },
    {
     "wait": 2
    },
    {
     "click": "#rStop"
    },
    {
     "wait": 3
    }
   ],
   "shots": [
    {
     "file": "zero_frames_1400.png"
    }
   ],
   "dumps": [
    {
     "file": "msg.txt",
     "selector": "#rMsg",
     "what": "text"
    }
   ]
  }
 ]
}