   "actions": [
    {
     "js": "const b=document.getElementById('sessBtn'); if(b.dataset.act==='stop') b.click(); return 'ok'"
    },
    {
     "wait": 3.5
    },
    {
     "click": "#rMode button[data-m=saved]"
    },
    {
     "set": "#rCfg",
     "value": "tap_run"
    },
    {
     "set": "#rDur",
     "value": "30"
    },
    {
     "click": "#rStart"
    },
    {
     "wait": 1.5
    },
