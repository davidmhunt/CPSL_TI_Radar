  {
   "name": "match_radar_1400",
   "tab": "run",
   "window": [
    1400,
    1000
   ],
   "actions": [
    {
     "js": "const b=document.getElementById('sessBtn'); if(b.dataset.act==='stop') b.click(); return 'ok'"
    },
    {
     "wait": 3.5
    },
    {
     "click": "#rMode button[data-m=saved]"
    },
    {
     "set": "#rCfg",
     "value": "a_fwmatch"
    },
    {
     "set": "#rDur",
     "value": "30"
    },
    {
     "click": "#rStart"
    },
    {
     "wait": 2.5
    }
   ],
   "shots": [
    {
     "file": "match_radar_1400.png"
    },
    {
     "file": "match_radar_1400_card.png",
     "selector": "#rFwVerdict"
    }
   ],
   "dumps": [
    {
     "file": "overflow.txt",
     "selector": "body",
     "what": "overflow"
    },
    {
     "file": "verdict.txt",
