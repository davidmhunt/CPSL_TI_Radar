  "tests/fakes/gui_fake_session.py"
 ],
 "user_cfgs": {
  "a_fwmatch.json": "{\"schema_version\": 2, \"board\": \"IWR1843\", \"firmware\": \"demo\", \"radar_cfg\": \"tap.cfg\", \"cli\": {\"port\": \"@PORT@\"}, \"serial_stream\": {\"enabled\": true}}",
  "a_fwmismatch.json": "{\"schema_version\": 2, \"board\": \"IWR1843_SAR\", \"firmware\": \"iwr1843_sar_lvds\", \"radar_cfg\": \"tap.cfg\", \"cli\": {\"port\": \"@PORT@\"}, \"serial_stream\": {\"enabled\": true}}",
  "a_fwskipped.json": "{\"schema_version\": 2, \"board\": \"AWR2243_CASCADE\", \"firmware\": \"cascade_ddm\", \"radar_cfg\": \"tap.cfg\", \"cli\": {\"port\": \"@PORT@\"}, \"serial_stream\": {\"enabled\": true}}",
  "a_fwunknown.json": "{\"schema_version\": 2, \"board\": \"IWR1843\", \"firmware\": \"demo\", \"radar_cfg\": \"tap.cfg\", \"cli\": {\"port\": \"@PORT@\"}, \"serial_stream\": {\"enabled\": true}}",
  "tap.cfg": "% fake\n"
 },
