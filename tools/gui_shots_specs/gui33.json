{
 "env": {
  "RADAR_GUI_DRIVER": "tests/fakes/fake_driver.py",
  "FAKE_DRIVER_MODE": "tap",
  "FAKE_DRIVER_RATE": "10",
  "FAKE_DRIVER_CLI": "ok",
  "FAKE_DRIVER_SKIP": "1",
  "FAKE_DRIVER_FW": "by-config"
 },
